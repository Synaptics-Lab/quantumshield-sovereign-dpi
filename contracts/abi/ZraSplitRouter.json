    { "name": "pay", "inputs": [{ "name": "amount", "type": "u128" }, { "name": "payee", "type": "Address" }, { "name": "entity", "type": "String" }], "outputs": [] },
    { "name": "get_payment_count", "inputs": [], "outputs": [{ "type": "u64" }] },
